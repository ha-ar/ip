<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         "Amber Glass" - Light palette (Windows 11 style, yellow brand accent)
         Every key here has an identical-named counterpart in Theme.Dark.xaml.
         App.xaml's styles reference these via DynamicResource so App.xaml.cs
         can swap the merged dictionary at runtime (startup + live OS theme
         change) and every window repaints without needing a restart.
         ===================================================================== -->

    <!-- Accent (brand yellow) - stays the same hue in both themes; only the
         roles that need to read as "dark text" flip since dark-on-dark would
         be invisible. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC300"/>
    <SolidColorBrush x:Key="AccentBrushDark" Color="#E0A800"/>
    <SolidColorBrush x:Key="AccentBrushDarker" Color="#8A6400"/>
    <!-- Translucent accent overlay - used for hover/selected tints. Being an
         alpha overlay rather than a flat pastel, it adapts to whatever
         surface sits behind it, so light and dark can share one value. -->
    <SolidColorBrush x:Key="AccentBrushLight" Color="#4DFFC300"/>

    <!-- Neutral surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F2FFFFFF"/>
    <!-- ~95% opaque white "glass" card -->
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#08000000"/>

    <!-- Form fields (TextBox / ComboBox / popup surfaces) -->
    <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="FieldMutedBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="FieldMutedPressedBrush" Color="#FFEDB8"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#1A1A1A"/>

    <!-- Semantic -->
    <!-- DangerBrush: solid danger surfaces (buttons, the "IP Conflict Detected"
         chip) that always carry white text on top. DangerTextBrush: red text
         sitting directly on a card background - needs to stay legible against
         SurfaceBrush, which is a different contrast requirement, hence a
         separate key rather than reusing DangerBrush for both roles. -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerBrushDark" Color="#A4221A"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="InfoTintBrush" Color="#FFF7DA"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#FDEDEC"/>
    <SolidColorBrush x:Key="DangerTintBorderBrush" Color="#F5C6C0"/>

    <!-- Elevation -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="16" Opacity="0.12"/>

</ResourceDictionary>
