<Window x:Class="ip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ip"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="AM.CO.ZA IP Setting Utility"
        Width="980"
        Height="700"
        MinWidth="840"
        MinHeight="580"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Main Container -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- Modern Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Tabs) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =====================================================================
             Modern App Header Bar
             ===================================================================== -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource HeaderBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0">
                        <TextBlock Text="IP" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AM.CO.ZA" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentBrushDarker}" Margin="0,0,6,0"/>
                            <TextBlock Text="IP Setting Utility" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- Version Pill Badge -->
                            <Border Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.01" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Network configuration tool for AM.CO.ZA CNC, Laser, and Printing machines" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions: Theme Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnThemeToggle" Style="{StaticResource ThemeToggleButtonStyle}" Click="BtnThemeToggle_Click" ToolTip="Toggle Light / Dark Theme">
                        <TextBlock Name="txtThemeIcon" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =====================================================================
             Modern Step Navigation (TabControl)
             ===================================================================== -->
        <TabControl Name="tabStrip" Grid.Row="1" TabStripPlacement="Top">

            <!-- =====================================================================
                 Tab 1: Network Interface
                 ===================================================================== -->
            <TabItem Header="1. Network Interface">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Margin="2,0,0,12">
                            <TextBlock Text="All Wired Network Connections" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select the physical Ethernet card connected to your AM.CO.ZA machine." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- NIC DataGrid Card -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="6">
                            <DataGrid Name="nicDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="NICDataGrid_SelectionChanged" ColumnWidth="*" MaxHeight="360">
                                <DataGrid.Columns>
                                    <!-- Select -->
                                    <DataGridTemplateColumn Header="Select" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="SelectedNic" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButtonStyle}">
                                                            <Setter Property="IsChecked" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="IsChecked" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Network Name -->
                                    <DataGridTemplateColumn Header="Network Adapter" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding name}" FontWeight="SemiBold" Style="{StaticResource DataGridTextBlockStyle}" ToolTip="{Binding name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Type -->
                                    <DataGridTemplateColumn Header="Type" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="10,0">
                                                    <TextBlock Text="{Binding type}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BadgeTextBrush}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- IP -->
                                    <DataGridTemplateColumn Header="IP Address" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding ip}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MonospaceTextBlockStyle}" />
                                                    <Image Width="20" Height="20" Source="{Binding systemImage}" Visibility="{Binding systemImageVisibility}" ToolTip="{Binding systemName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Speed -->
                                    <DataGridTemplateColumn Header="Speed" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding speed}" Style="{StaticResource DataGridTextBlockStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Up Time -->
                                    <DataGridTemplateColumn Header="Up Time" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding uptime}" Style="{StaticResource DataGridTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Notification / Action InfoBars -->
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <!-- Notification: Version -->
                            <Border Name="ntfVersion" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Name="ntfVersionText" Grid.Column="1" VerticalAlignment="Center" FontSize="13">New version available. Please download from <Hyperlink NavigateUri="https://www.SetIP.co.za" RequestNavigate="Hyperlink_RequestNavigate">www.SetIP.co.za</Hyperlink></TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource BlueButtonStyle}" Content="Download" Click="BtnDownload_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Network Adapter -->
                            <Border Name="ntfNetworkAdapter" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13">No network port detected. You can use a Generic USB 3.0 to Gigabit Ethernet Adapter.</TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource BlueButtonStyle}" Content="Buy Network Adapter" Click="BtnNetworkAdapter_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Network Cable -->
                            <Border Name="ntfNetworkCable" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13">No network cable is connected. Please connect a CAT6 cable to your machine's port.</TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource BlueButtonStyle}" Content="Buy Network Cable" Click="BtnNetworkCable_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Offline -->
                            <Border Name="ntfOffline" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="No internet connection" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource DangerTextBrush}"/>
                                        <TextBlock Text="Please connect this computer to the internet and click Try Again." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource OrangeButtonStyle}" Content="Try Again" Click="BtnTryAgain_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Select, Then Next [1] -->
                            <Border Name="ntfSelectThenNext1" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Name="ntfSelectThenNext1Text" Grid.Column="1" VerticalAlignment="Center" FontSize="13">Please select the network interface connected to your AM.CO.ZA machine, then click "Next".</TextBlock>
                                    <Button Name="ntfSelectThenNext1Button" Grid.Column="2" Style="{StaticResource BlueButtonStyle}" Content="Next Step" Click="BtnNext1_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Login -->
                            <Border Name="ntfLogin" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="6,0,10,0">
                                        <TextBlock Text="Software Activation Required" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AccentBrushDarker}"/>
                                        <TextBlock Text="Please activate this software using the verification code sent to your WhatsApp." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Name="cbCountry1" Grid.Column="1" Margin="6" VerticalAlignment="Center" SelectedValuePath="dial_code">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding name}" /><Run Text=" (" /><Run Text="{Binding dial_code}" /><Run Text=")" /></TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Column="2" Margin="6">
                                        <TextBox x:Name="txtPhone1" Width="150" Height="34" VerticalContentAlignment="Center" />
                                        <TextBlock Text="Phone number" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=txtPhone1, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                    <Button Grid.Column="3" Margin="6" Style="{StaticResource BlueButtonStyle}" Content="Send Code" Click="BtnSend_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: OTP -->
                            <Border Name="ntfOTP" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="cbCountry2" Grid.Column="0" IsReadOnly="True" GotFocus="ChangePhoneNumber" VerticalAlignment="Center" Margin="6" SelectedValuePath="dial_code">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding name}" /><Run Text=" (" /><Run Text="{Binding dial_code}" /><Run Text=")" /></TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Column="1" Margin="6">
                                        <TextBox x:Name="txtPhone2" IsReadOnly="True" VerticalContentAlignment="Center" GotFocus="ChangePhoneNumber" Width="150" Height="34" />
                                        <TextBlock Text="Phone number" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=txtPhone2, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                    <Grid Grid.Column="2" Margin="6">
                                        <TextBox x:Name="txtOTP" Width="150" Height="34" VerticalContentAlignment="Center" />
                                        <TextBlock Text="Verification Code" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=txtOTP, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6">
                                        <Button Style="{StaticResource BlueButtonStyle}" Content="Confirm OTP" Click="BtnConfirm_Click" />
                                        <Button Name="BtnResend" Style="{StaticResource OrangeButtonStyle}" Content="Resend" Click="BtnResend_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Loading Spinner -->
                            <local:LoadingSpinner x:Name="ntfLoadingSpinnerNic" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- =====================================================================
                 Tab 2: Machine Type
                 ===================================================================== -->
            <TabItem Header="2. Machine Type" Name="tabMachineType" IsEnabled="False" Visibility="{Binding LoggedInTabVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Margin="2,0,0,12">
                            <TextBlock Text="Select Connected Machine Model" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select your CNC, laser cutter, or printer model to apply its target IP address and MTU configurations." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Machine Type DataGrid Card -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="6">
                            <DataGrid Name="machineTypeDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="MachineTypeDataGrid_SelectionChanged" ColumnWidth="*" MaxHeight="360">
                                <DataGrid.Columns>
                                    <!-- Select -->
                                    <DataGridTemplateColumn Header="Select" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="SelectedMachineType" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButtonStyle}">
                                                            <Setter Property="IsChecked" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="IsChecked" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Image Preview -->
                                    <DataGridTemplateColumn Header="Preview" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource CardBackgroundElevatedBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding SystemImage}" Height="30" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- System Name -->
                                    <DataGridTemplateColumn Header="Machine / System" Width="*" MinWidth="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding System}" FontWeight="SemiBold" Style="{StaticResource DataGridTextBlockStyle}" ToolTip="{Binding System}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- NIC IP -->
                                    <DataGridTemplateColumn Header="NIC IP" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NicIP}" Style="{StaticResource MonospaceTextBlockStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Jumbo Frame -->
                                    <DataGridTemplateColumn Header="Jumbo Frame" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding JumboFrame}" Style="{StaticResource DataGridTextBlockStyle}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Speed -->
                                    <DataGridTemplateColumn Header="Speed" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Speed}" Style="{StaticResource DataGridTextBlockStyle}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Device IP -->
                                    <DataGridTemplateColumn Header="Device IP" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeviceIP}" Style="{StaticResource MonospaceTextBlockStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Notification / Step 2 Action -->
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <Border Name="ntfSelectThenNext2" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Name="ntfSelectThenNext2Text" Grid.Column="1" VerticalAlignment="Center" FontSize="13">Please select your machine model, then click "Apply &amp; Test Connection".</TextBlock>
                                    <Button Name="ntfSelectThenNext2Button" Grid.Column="2" Style="{StaticResource BlueButtonStyle}" Content="Apply &amp; Test Connection" Click="BtnNext2_Click" />
                                </Grid>
                            </Border>

                            <!-- Loading Spinner -->
                            <local:LoadingSpinner x:Name="ntfLoadingSpinnerMachineType" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- =====================================================================
                 Tab 3: Status & Diagnostics
                 ===================================================================== -->
            <TabItem Header="3. Status &amp; Diagnostics" Name="tabStatus" IsEnabled="False" Visibility="{Binding LoggedInTabVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Status Overview Dashboard -->
                        <StackPanel Grid.Row="0">
                            <!-- Hero Device Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Machine Image in Elevation Frame -->
                                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="12" Background="{DynamicResource CardBackgroundElevatedBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" Effect="{DynamicResource CardShadowSubtle}" Margin="0,0,20,0">
                                        <Image Width="80" Height="80" Source="{Binding SelectedMachineType.SystemImage}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Right Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Machine Title -->
                                        <TextBlock Text="{Binding SelectedMachineType.System}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                        <!-- Success State Grid -->
                                        <StackPanel Name="SuccessStatus" Visibility="Collapsed">
                                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                                <!-- Metric 1: Selected Adapter -->
                                                <Border Style="{StaticResource StatCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="NETWORK INTERFACE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatLabelBrush}"/>
                                                            <TextBlock Text="{Binding SelectedNIC.name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource StatValueBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedNIC.name}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Metric 2: IP Address -->
                                                <Border Style="{StaticResource StatCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="ASSIGNED IP ADDRESS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatLabelBrush}"/>
                                                            <TextBlock Text="{Binding SelectedNIC.ip}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, Cascadia Code" Foreground="{DynamicResource StatValueBrush}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="/img/yes.png" Width="22" Height="22" Visibility="{Binding ip_yes}" />
                                                            <Image Source="/img/warning.png" Width="22" Height="22" Visibility="{Binding ip_warning}" />
                                                            <Image Source="/img/no.png" Width="22" Height="22" Visibility="{Binding ip_no}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Metric 3: Speed -->
                                                <Border Style="{StaticResource StatCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="LINK SPEED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatLabelBrush}"/>
                                                            <TextBlock Text="{Binding SelectedNIC.speed}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource StatValueBrush}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="/img/yes.png" Width="22" Height="22" Visibility="{Binding speed_yes}" />
                                                            <Image Source="/img/warning.png" Width="22" Height="22" Visibility="{Binding speed_warning}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Metric 4: Jumbo Frame -->
                                                <Border Style="{StaticResource StatCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="JUMBO FRAME (MTU)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatLabelBrush}"/>
                                                            <TextBlock Text="{Binding SelectedNIC.jumboFrame}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource StatValueBrush}" Margin="0,3,0,0"/>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding jumbo_frame_maybe}" Margin="0,4,0,0">
                                                                <Image Source="/img/maybe.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Configure in Device Manager" FontSize="11.5" Foreground="{DynamicResource WarningTextBrush}"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding jumbo_frame_no}" Margin="0,4,0,0">
                                                                <Image Source="/img/no.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Update Network Driver" FontSize="11.5" Foreground="{DynamicResource DangerTextBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="/img/yes.png" Width="22" Height="22" Visibility="{Binding jumbo_frame_yes}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>

                                        <!-- Error State: IP Conflict -->
                                        <StackPanel Name="ErrorIPConflict" Visibility="Collapsed" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                                <TextBlock Text="IP Conflict Detected" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="20">
                                                <Run Text="{Binding SelectedMachineType.System}" FontWeight="SemiBold" /> requires IP <Run Text="{Binding SelectedMachineType.NicIP}" FontWeight="Bold" />.<LineBreak />
                                                This IP is currently in use by <Run Text="{Binding SelectedNIC.name}" FontWeight="SemiBold" />.<LineBreak />
                                                Click the Release button below to free this IP address automatically.
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Error State: Failed to set IP -->
                                        <StackPanel Name="ErrorFailedToSetIPAddress" Visibility="Collapsed" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                                <TextBlock Text="Failed to Configure IP Address" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="Unable to apply the required IP to this adapter. Please try again or run as Administrator." FontSize="13" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Ping Latency Chart Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,10,0,0" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Chart Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Live Device Latency &amp; Packet Response" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Real-Time Ping (ms)" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>

                                    <!-- Live Chart -->
                                    <lvc:CartesianChart Grid.Row="1" Name="PingChart" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="190" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Notification InfoBars -->
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <!-- Notification: Ping Status -->
                            <Border Name="ntfPingStatus" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Name="txtPingStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="13">Ping Status: Active</TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource BlueButtonStyle}" Content="Close Status" Click="BtnClosePingStatus_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: IP Conflict -->
                            <Border Name="ntfIpConflict" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold" FontSize="13">IP address conflict detected. Click Release to free this IP from the conflicting network interface.</TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource RoundedRedButtonStyle}" Content="Release IP" Click="BtnRelease_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Failed to set IP address -->
                            <Border Name="ntfFailedToSetIPAddress" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold" FontSize="13">Failed to set up the IP address. Please try again.</TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource RoundedRedButtonStyle}" Content="Try Again" Click="BtnRetrySetIP_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Failed to set IP address again -->
                            <Border Name="ntfFailedToSetIPAddressAgain" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold" FontSize="13">Failed to set up IP again. Please reinstall the network card driver and restart.</TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource RoundedRedButtonStyle}" Content="Delete &amp; Reboot" Click="BtnDeleteAndReboot_Click" />
                                </Grid>
                            </Border>

                            <!-- Loading Spinner -->
                            <local:LoadingSpinner x:Name="ntfLoadingSpinnerStatus" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
