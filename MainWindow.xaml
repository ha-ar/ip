<Window x:Class="ip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ip"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="IP Setting for AM.CO.ZA Machines"
        Width="960"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <!-- Main child -->
    <Grid Margin="16,16,16,10">
        <Grid.RowDefinitions>
            <!-- Content area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <TabControl Name="tabStrip" Grid.Row="0" TabStripPlacement="Bottom">

            <!-- Tab item: Network Interface -->
            <TabItem Header="Network Interface">

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,14,0,0">

                    <!-- ScrollViewer content -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- Auto, not *: with only a couple of rows of data this card should hug its
                                 content, not stretch to fill the whole tab and leave a big empty card
                                 (visible in the original screenshot's dead space below the grid). -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Text="All Wired Network Connections" FontSize="16" FontWeight="SemiBold" Margin="2 0 0 10" />

                        <!-- NIC DataGrid -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="4">
                            <DataGrid Name="nicDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="NICDataGrid_SelectionChanged" ColumnWidth="*" MaxHeight="360">

                                <DataGrid.Columns>
                                    <!-- Select -->
                                    <DataGridTemplateColumn Header="Select" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- GroupName is scoped per-Window in WPF, so this must be distinct from the
                                                     Machine Type grid's radio column below - otherwise selecting a row here
                                                     can uncheck the (unrelated) selection over on the Machine Type tab. -->
                                                <RadioButton GroupName="SelectedNic" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButtonStyle}">
                                                            <Setter Property="IsChecked" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="IsChecked" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Other columns -->
                                    <DataGridTextColumn Header="Network" IsReadOnly="True" Binding="{Binding name}" ElementStyle="{StaticResource DataGridTextBlockStyle}" />
                                    <DataGridTextColumn Header="Type" Width="90" IsReadOnly="True" Binding="{Binding type}" ElementStyle="{StaticResource DataGridTextBlockStyle}" />

                                    <!-- IP -->
                                    <DataGridTemplateColumn Header="IP">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ip}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DataGridTextBlockStyle}" />
                                                    <Image Width="20" Height="20" Source="{Binding systemImage}" Visibility="{Binding systemImageVisibility}" ToolTip="{Binding systemName}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Other columns -->
                                    <DataGridTextColumn Header="Speed" Width="110" IsReadOnly="True" Binding="{Binding speed}" ElementStyle="{StaticResource DataGridTextBlockStyle}" />
                                    <DataGridTextColumn Header="Up Time" Width="110" IsReadOnly="True" Binding="{Binding uptime}" ElementStyle="{StaticResource DataGridTextBlockStyle}" />
                                </DataGrid.Columns>

                                <!-- / Network grid -->
                            </DataGrid>
                        </Border>

                        <!-- Notifications -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <!-- Notification: Version -->
                            <Border Name="ntfVersion" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Name="ntfVersionText" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">New version ... is now available. Please download it from <Hyperlink NavigateUri="https://www.SetIP.co.za" RequestNavigate="Hyperlink_RequestNavigate">www.SetIP.co.za</Hyperlink></TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource BlueButtonStyle}" Content="Download" Click="BtnDownload_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Network Adapter -->
                            <Border Name="ntfNetworkAdapter" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center">If your computer doesn't have a network port, you can get this<LineBreak/>Generic USB 3.0 to Gigabit Ethernet Adapter online.</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource BlueButtonStyle}" Content="Buy Network Adapter" Click="BtnNetworkAdapter_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Network Cable -->
                            <Border Name="ntfNetworkCable" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center">No network cable is connected to any port. Please try a different<LineBreak/>cable. You can also buy a CAT6 network cable online.</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource BlueButtonStyle}" Content="Buy Network Cable" Click="BtnNetworkCable_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Offline -->
                            <Border Name="ntfOffline" Style="{StaticResource DangerCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" Padding="5" VerticalAlignment="Center">No internet connection.</TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Padding="5" VerticalAlignment="Center">Please connect this computer to the internet and try again.</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource OrangeButtonStyle}" Content="Try Again" Click="BtnTryAgain_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Select, Then Next [1] -->
                            <Border Name="ntfSelectThenNext1" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center" Name="ntfSelectThenNext1Text">Please select the network interface connected to your AM.CO.ZA machine, then click "Next".</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource BlueButtonStyle}" Content="Next" Click="BtnNext1_Click" Name="ntfSelectThenNext1Button"/>
                                </Grid>
                            </Border>

                            <!-- Notification: Login -->
                            <Border Name="ntfLogin" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="10">Before continuing, please activate<LineBreak />this software using the verification<LineBreak />code sent to your WhatsApp.</TextBlock>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="10" VerticalAlignment="Center" Name="cbCountry1" SelectedValuePath="dial_code">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding name}" /><Run Text=" (" /><Run Text="{Binding dial_code}" /><Run Text=")" /></TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Row="0" Grid.Column="2" Margin="10">
                                        <TextBox x:Name="txtPhone1" Width="150" Height="32" VerticalContentAlignment="Center" />
                                        <TextBlock Text="Enter phone number" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=txtPhone1, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                    <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="1" Margin="10" Style="{StaticResource BlueButtonStyle}" Content="Send" Click="BtnSend_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: OTP -->
                            <Border Name="ntfOTP" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ComboBox Grid.Row="0" Grid.Column="0" IsReadOnly="True" GotFocus="ChangePhoneNumber" VerticalAlignment="Center" Margin="10" Name="cbCountry2" SelectedValuePath="dial_code">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding name}" /><Run Text=" (" /><Run Text="{Binding dial_code}" /><Run Text=")" /></TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Row="0" Grid.Column="1" Margin="10">
                                        <TextBox x:Name="txtPhone2" IsReadOnly="True" VerticalContentAlignment="Center" GotFocus="ChangePhoneNumber" Width="150" Height="32" />
                                        <TextBlock Text="Enter phone number" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=txtPhone2, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="2" Margin="10">
                                        <TextBox x:Name="txtOTP" Width="150" Height="32" VerticalContentAlignment="Center" />
                                        <TextBlock Text="Verification Code" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=txtOTP, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="1" Margin="10" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BlueButtonStyle}" Content="Confirm" Click="BtnConfirm_Click" />
                                        <Button Style="{StaticResource OrangeButtonStyle}" Name="BtnResend" Content="Resend" Click="BtnResend_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Loading Spinner -->
                            <local:LoadingSpinner x:Name="ntfLoadingSpinnerNic" Visibility="Collapsed" />

                        <!-- / Notifications -->
                        </StackPanel>

                    <!-- / ScrollViewer content -->
                    </Grid>

                <!-- / Scrollable content -->
                </ScrollViewer>

            <!-- / Tab item: Network Interface -->
            </TabItem>

            <!-- Tab item: Machine Type -->
            <TabItem Header="Machine Type" Name="tabMachineType" IsEnabled="False" Visibility="{Binding LoggedInTabVisibility}">

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,14,0,0">

                    <!-- ScrollViewer content -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Auto, not *: same reasoning as the Network Interface tab above - the
                                 card should hug its content instead of stretching to fill the tab. -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Machine Type DataGrid -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="4">
                            <DataGrid Name="machineTypeDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="MachineTypeDataGrid_SelectionChanged" ColumnWidth="*" MaxHeight="360">

                                <DataGrid.Columns>
                                    <!-- Select -->
                                    <DataGridTemplateColumn Header="Select" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Distinct GroupName from the Network Interface grid above - see the comment there. -->
                                                <RadioButton GroupName="SelectedMachineType" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <RadioButton.Style>
                                                        <Style TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButtonStyle}">
                                                            <Setter Property="IsChecked" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="IsChecked" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RadioButton.Style>
                                                </RadioButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- System -->
                                    <DataGridTemplateColumn Header="Image" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="10" Background="Transparent">
                                                    <Image Source="{Binding SystemImage}" Height="50" Width="50"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- System -->
                                    <DataGridTextColumn Header="System" IsReadOnly="True" Binding="{Binding System}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Margin" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- NIC IP -->
                                    <DataGridTextColumn Header="NIC IP" Width="140" IsReadOnly="True" Binding="{Binding NicIP}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Margin" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Jumbo Frame -->
                                    <DataGridTextColumn Header="Jumbo Frame" Width="130" IsReadOnly="True" Binding="{Binding JumboFrame}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Margin" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Speed -->
                                    <DataGridTextColumn Header="Speed" Width="110" IsReadOnly="True" Binding="{Binding Speed}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Margin" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Device IP -->
                                    <DataGridTextColumn Header="Device IP" Width="140" IsReadOnly="True" Binding="{Binding DeviceIP}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Margin" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Set To Interface -->
                                    <!--
                                        <DataGridTemplateColumn Header="Set To Interface">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Set To Interface" Command="{Binding Path=DataContext.SetToInterfaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="10" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        -->
                                </DataGrid.Columns>

                                <!-- / Machine Type grid -->
                            </DataGrid>
                        </Border>

                        <!-- Notifications -->
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <!-- Notification: Select, Then Next [2] -->
                            <Border Name="ntfSelectThenNext2" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center" Name="ntfSelectThenNext2Text">Please select the machine type or system connected, then click "Next".</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource BlueButtonStyle}" Content="Next" Click="BtnNext2_Click" Name="ntfSelectThenNext2Button"/>
                                </Grid>
                            </Border>

                            <!-- Loading Spinner -->
                            <local:LoadingSpinner x:Name="ntfLoadingSpinnerMachineType" Visibility="Collapsed" />
                        </StackPanel>

                    <!-- / ScrollViewer content-->
                    </Grid>

                <!-- / Scrollable content -->
                </ScrollViewer>

            <!-- / Tab item: Machine Type -->
            </TabItem>

            <!-- Tab item: Status -->
            <TabItem Header="Status" Name="tabStatus" IsEnabled="False" Visibility="{Binding LoggedInTabVisibility}">

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,14,0,0">

                    <!-- ScrollViewer content -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>

                            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Image -->
                                    <Image Width="120" Height="120" Margin="0 0 20 0" Source="{Binding SelectedMachineType.SystemImage}"></Image>

                                    <!-- Success Status -->
                                    <StackPanel Name="SuccessStatus" Margin="0 5 10 0" Visibility="Collapsed">
                                        <TextBlock Text="{Binding SelectedMachineType.System}" FontSize="15" FontWeight="Bold" Padding="0 0 0 10" />
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">Network Interface selected:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.name}"></TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">IP Address:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.ip}" />
                                            <Image Source="/img/yes.png" Width="20" Height="20" Visibility="{Binding ip_yes}" />
                                            <Image Source="/img/warning.png" Width="20" Height="20" Visibility="{Binding ip_warning}" />
                                            <Image Source="/img/no.png" Width="20" Height="20" Visibility="{Binding ip_no}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">Network Speed:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.speed}" />
                                            <Image Source="/img/yes.png" Width="20" Height="20" Visibility="{Binding speed_yes}" />
                                            <Image Source="/img/warning.png" Width="20" Height="20" Visibility="{Binding speed_warning}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">Jumbo Frame:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.jumboFrame}" />
                                            <Image Source="/img/yes.png" Width="20" Height="20" Visibility="{Binding jumbo_frame_yes}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding jumbo_frame_maybe}">
                                                <Image Source="/img/maybe.png" Width="20" Height="20" Margin="0 0 5 0" />
                                                <TextBlock>Open Device Manager to edit Jumbo Frame.</TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding jumbo_frame_no}">
                                                <Image Source="/img/no.png" Width="20" Height="20" Margin="0 0 5 0" />
                                                <TextBlock>Update Network Card driver or update to a more modern device.</TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Error: IP Conflict Detected -->
                                    <StackPanel Name="ErrorIPConflict" Margin="0 5 10 0" Visibility="Collapsed">
                                        <TextBlock Text="{Binding SelectedMachineType.System}" FontSize="15" FontWeight="Bold" Padding="0 0 0 10" />
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">Network Interface selected:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.name}"></TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">IP Address Needed:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedMachineType.NicIP}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="8">
                                            <TextBlock Margin="10" HorizontalAlignment="Stretch" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="IP Conflict Detected" />
                                        </Border>
                                        <TextBlock Margin="0 10 0 0"><Run Text="{Binding SelectedMachineType.System}" /> requires the IP address<LineBreak /><Run Text="{Binding SelectedMachineType.NicIP}" />. However, this IP address is currently in use by <Run Text="{Binding SelectedNIC.name}" />.<LineBreak />Please go back to the Network Interface tab to check if you selected the wrong network<LineBreak />interface, or click the Release button to free this IP address.</TextBlock>
                                    </StackPanel>

                                    <!-- Error: Failed to set IP address -->
                                    <StackPanel Name="ErrorFailedToSetIPAddress" Margin="0 5 10 0" Visibility="Collapsed">
                                        <TextBlock Text="{Binding SelectedMachineType.System}" FontSize="15" FontWeight="Bold" Padding="0 0 0 10" />
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">Network Interface selected:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.name}"></TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <TextBlock Padding="0 0 5 0">IP Address:</TextBlock>
                                            <TextBlock Padding="0 0 5 0" Text="{Binding SelectedNIC.ip}" />
                                            <Image Source="/img/no.png" Width="20" Height="20" />
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Chart -->
                            <lvc:CartesianChart Grid.Row="1" Name="PingChart" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="200" Margin="0,10,0,0" Visibility="Collapsed" />

                        </StackPanel>

                        <!-- Notifications -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">

                            <!-- Notification: Ping Status -->
                            <Border Name="ntfPingStatus" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center" Name="txtPingStatus">Ping Status</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource BlueButtonStyle}" Content="Close" Click="BtnClosePingStatus_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: IP Conflict -->
                            <Border Name="ntfIpConflict" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold">IP address conflict detected. Click Release to release the IP address from the other network interface.</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource RoundedRedButtonStyle}" Content="Release" Click="BtnRelease_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Failed to set IP address -->
                            <Border Name="ntfFailedToSetIPAddress" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold">Failed to set up the IP address. Please try again.</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource RoundedRedButtonStyle}" Content="Try Again" Click="BtnRetrySetIP_Click" />
                                </Grid>
                            </Border>

                            <!-- Notification: Failed to set IP address, again -->
                            <Border Name="ntfFailedToSetIPAddressAgain" Style="{StaticResource TintCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DangerNotificationIconStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="5" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold">Failed to set up the IP address again. Please delete the network card driver and restart your PC.</TextBlock>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Style="{StaticResource RoundedRedButtonStyle}" Content="Delete &amp; Reboot" Click="BtnDeleteAndReboot_Click" />
                                </Grid>
                            </Border>

                            <!-- Loading Spinner -->
                            <local:LoadingSpinner x:Name="ntfLoadingSpinnerStatus" Visibility="Collapsed" />

                        <!-- / Notifications -->
                        </StackPanel>

                    <!-- / ScrollViewer conetnt -->
                    </Grid>

                <!-- / Scrollable content -->
                </ScrollViewer>

            <!-- / Tab item: Status -->
            </TabItem>

        <!-- / Tab strip -->
        </TabControl>

    <!-- / Main child -->
    </Grid>
</Window>
