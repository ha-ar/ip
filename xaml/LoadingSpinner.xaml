<UserControl x:Class="ip.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Global storyboard -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="SpinnerRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:0.9" />
        </Storyboard>
    </UserControl.Resources>

    <Border Style="{StaticResource GlassCardStyle}">
        <!-- Ring + text, centered -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Fluent-style progress ring -->
            <Grid Width="24" Height="24" Margin="0,0,12,0">
                <Ellipse Width="24" Height="24" Stroke="{DynamicResource SurfaceBorderBrush}" StrokeThickness="3"/>
                <Ellipse Width="24" Height="24"
                         Stroke="{DynamicResource AccentBrushDark}"
                         StrokeThickness="3"
                         StrokeDashArray="1.6 10"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Static Loading text -->
            <TextBlock Text="Loading..."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Trigger animation -->
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource SpinAnimation}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</UserControl>
